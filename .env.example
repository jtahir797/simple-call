# Copy to .env.local for local dev. On Vercel: Project Settings > Environment Variables.
# Never commit real values and never prefix any of these with NEXT_PUBLIC_.

# --- Required: the three values the organizers email you ---
LITELLM_BASE_URL=https://<gateway address from organizers>/v1
LITELLM_API_KEY=sk-your-personal-key
LITELLM_MODEL=claude-sonnet-5-5

# --- Optional: cost control ---
# Fast, cheap model for Listener, Psychology, Risk and Clarify (they run on every line).
LITELLM_FAST_MODEL=claude-haiku
# The key has $25 in total for building AND judging. Live AI stops at this many USD of key spend and the
# app switches to Instant replay (0 tokens). Spend is read from LiteLLM itself when available.
SPEND_CAP_USD=20
# Model calls per minute across the app (the key allows 60). Bursts wait for the next minute instead of failing.
MODEL_RPM=55
# Optional: USD per million tokens, used for the local spend estimate if the gateway does not report spend.
PRICE_MAIN_IN=3
PRICE_MAIN_OUT=15
PRICE_FAST_IN=1
PRICE_FAST_OUT=5
# Emergency kill switch: set to "off" to disable all live model calls (replay keeps working).
SIMPLECALL_AI=

# --- Optional: security ---
# If set, every AI request must send this code (the UI asks for it once per browser session).
ACCESS_CODE=
# Extra allowed origins (comma separated), e.g. a custom domain. Same-origin is always allowed.
ALLOWED_ORIGINS=

# --- Optional: shared store (Upstash Redis free tier) ---
# Makes rate limits, the daily budget and the response cache global across all Vercel instances.
# Without it they are per instance (still enforced, just not shared).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
