# PRIVATE MODE: everything on your laptop. Audio (on-device speech), transcripts (this browser) and the
# AI model (Ollama) never leave the machine. Use this for real client calls.
#
#   1. Install Ollama (https://ollama.com) and pull a model:   ollama pull qwen2.5:7b      (and optionally llama3.2:3b)
#   2. cp .env.private.example .env.local
#   3. npm run private      ->  http://127.0.0.1:3000 (bound to this machine only)
LITELLM_BASE_URL=http://127.0.0.1:11434/v1
LITELLM_API_KEY=ollama
LITELLM_MODEL=qwen2.5:7b
# Smaller, faster model for Listener, Psychology and Risk (they run on every line)
LITELLM_FAST_MODEL=llama3.2:3b
# Local models follow the JSON format much better with JSON mode on
LLM_JSON_MODE=1
# A local model costs nothing: switch the spend cap and per-minute limit off
SPEND_CAP_USD=1000000
MODEL_RPM=100000
PRICE_MAIN_IN=0
PRICE_MAIN_OUT=0
PRICE_FAST_IN=0
PRICE_FAST_OUT=0
